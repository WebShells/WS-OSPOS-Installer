#!/usr/bin/env bash

set -u

readonly RELEASE_URL='https://github.com/opensourcepos/opensourcepos/releases/download/3.3.8/opensourcepos.3.3.8.ffe492.zip'
readonly INSTALL_ROOT="${HOME}/OSPOS"
readonly WEBROOT="${HOME}/public_html/OSPOS"
readonly WEBROOT_BACKUP="${HOME}/public_html/OSPOSBK"
readonly ZIP_FILE="${HOME}/OSPOS.zip"

log() {
    printf '%s\n' "$*"
}

require_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        log "Missing required command: $1"
        exit 1
    fi
}

sanitize_token() {
    printf '%s' "$1" | tr -cd '[:alnum:]_'
}

current_user() {
    id -un
}

banner() {
    if command -v clear >/dev/null 2>&1; then
        clear
    fi

    log "Starting OSPOS Installation Process"
    log "THIS INSTALLATION SHOULD BE RUNNING ON BASE DIRECTORY"
    log "AT $HOME, OUTSIDE PUBLIC_HTML"
    log ""
    log "###########################################################################"
    log "#  __      __      ___.     _________.__           .__  .__               #"
    log "# /  \\    /  \\ ____\\_ |__  /   _____/|  |__   ____ |  | |  |   ______     #"
    log "# \\   \\/\\/   // __ \\| __ \\ \\_____  \\ |  |  \\_/ __ \\|  | |  |  /  ___/     #"
    log "#  \\        /\\  ___/| \\_\\ \\/        \\|   Y  \\  ___/|  |_|  |__\\___ \\      #"
    log "#   \\__/\\  /  \\___  >___  /_______  /|___|  /\\___  >____/____/____  >     #"
    log "#        \/       \/    \/        \/      \/     \/               \/      #"
    log "#                         WS - OS POS Auto Installer                      #"
    log "###########################################################################"
}

cleanup() {
    rm -f "$ZIP_FILE"
}

backup_webroot() {
    mkdir -p "${HOME}/public_html"

    if [ -d "$WEBROOT" ]; then
        rm -rf "$WEBROOT_BACKUP"
        mv "$WEBROOT" "$WEBROOT_BACKUP"
    fi
}

download_release() {
    require_cmd curl
    log ""
    log "Downloading OSPOS release..."
    curl -fL "$RELEASE_URL" -o "$ZIP_FILE"
}

extract_release() {
    require_cmd unzip
    rm -rf "$INSTALL_ROOT"
    log ""
    log "Extracting files..."
    unzip -q "$ZIP_FILE" -d "$INSTALL_ROOT"
}

write_database_config() {
    local dbname="$1"
    local dbuser="$2"
    local dbpass="$3"
    local config_file="${INSTALL_ROOT}/application/config/database.php"
    local user_prefix

    user_prefix="$(current_user)"

    mkdir -p "${INSTALL_ROOT}/application/config"

    cat > "$config_file" <<EOF
<?php
defined('BASEPATH') OR exit('No direct script access allowed');
\$active_group = 'default';
\$query_builder = TRUE;

\$db['default'] = array(
  'dsn'   => '',
  'hostname' => 'localhost',
  'username' => '${user_prefix}_${dbuser}',
  'password' => '${dbpass}',
  'database' => '${user_prefix}_${dbname}',
  'dbdriver' => 'mysqli',
  'dbprefix' => 'ospos_',
  'pconnect' => FALSE,
  'db_debug' => (ENVIRONMENT !== 'production'),
  'cache_on' => FALSE,
  'cachedir' => '',
  'char_set' => 'utf8',
  'dbcollat' => 'utf8_general_ci',
  'swap_pre' => '',
  'encrypt' => FALSE,
  'compress' => FALSE,
  'stricton' => FALSE,
  'failover' => array(),
  'save_queries' => TRUE
);
EOF
}

create_mysql_db() {
    require_cmd mysql

    local dbname="$1"
    local dbuser="$2"
    local dbpass="$3"
    local dbname_full
    local dbuser_full
    local admin_user
    local admin_pass

    admin_user="$(current_user)"
    dbname_full="${admin_user}_${dbname}"
    dbuser_full="${admin_user}_${dbuser}"

    log ""
    log "Please enter the SQL privileged password for user: ${admin_user}"
    read -r -s admin_pass
    log ""

    if ! mysql -u "$admin_user" --password="$admin_pass" --execute="CREATE SCHEMA \`${dbname_full}\`;" >/dev/null 2>&1; then
        if mysql -u "$admin_user" --password="$admin_pass" --execute="SHOW DATABASES LIKE '${dbname_full}';" 2>/dev/null | grep -q "$dbname_full"; then
            log "MySQL database '${dbname_full}' already exists"
            log "Please rerun the installer with a different database name."
            return 1
        fi

        log "Failed to create database '${dbname_full}'"
        log "Please check your credentials"
        return 1
    fi

    mysql -u "$admin_user" --password="$admin_pass" --execute="CREATE USER '${dbuser_full}'@'%' IDENTIFIED BY '${dbpass}';" >/dev/null 2>&1 || true
    mysql -u "$admin_user" --password="$admin_pass" --execute="GRANT ALL PRIVILEGES ON \`${dbname_full}\`.* TO '${dbuser_full}'@'%' WITH GRANT OPTION;" >/dev/null 2>&1 || true
    mysql -u "$admin_user" --password="$admin_pass" --execute="FLUSH PRIVILEGES;" >/dev/null 2>&1 || true

    log ""
    log "Importing default database values..."
    mysql -h localhost -u "$dbuser_full" --password="$dbpass" "$dbname_full" < "${INSTALL_ROOT}/database/database.sql" >/dev/null 2>&1
    log "47 SQL tables created"
}

create_cpanel_db() {
    require_cmd mysql

    local dbname="$1"
    local dbuser="$2"
    local dbpass="$3"
    local dbname_full
    local dbuser_full
    local uapi_bin
    local admin_user

    admin_user="$(current_user)"
    dbname_full="${admin_user}_${dbname}"
    dbuser_full="${admin_user}_${dbuser}"

    if command -v uapi >/dev/null 2>&1; then
        uapi_bin="$(command -v uapi)"
    elif [ -x /usr/bin/uapi ]; then
        uapi_bin='/usr/bin/uapi'
    else
        log "uapi was not found. This path is intended for cPanel-style hosting."
        return 1
    fi

    "$uapi_bin" Mysql create_database name="$dbname_full" >/dev/null 2>&1 || true
    "$uapi_bin" Mysql create_user name="$dbuser_full" password="$dbpass" >/dev/null 2>&1 || true
    "$uapi_bin" Mysql set_privileges_on_database user="$dbuser_full" database="$dbname_full" privileges=ALL%20PRIVILEGES >/dev/null 2>&1 || true

    log ""
    log "Importing default database values..."
    mysql -h localhost -u "$dbuser_full" --password="$dbpass" "$dbname_full" < "${INSTALL_ROOT}/database/database.sql" >/dev/null 2>&1
    log "47 SQL tables created"
}

publish_install() {
    mkdir -p "${HOME}/public_html"
    rm -rf "$WEBROOT"
    cp -R "$INSTALL_ROOT" "$WEBROOT"
}

display_system_info() {
    log ""
    log "System Info"
    log "#########################################"
    log ""
    uname -a
    log ""
    log ">> PHP Version:"
    if command -v php >/dev/null 2>&1; then
        php -v
    else
        log "php not found"
    fi
    log ""
    log ">> MySQL Version:"
    if command -v mysql >/dev/null 2>&1; then
        mysql --version
    else
        log "mysql not found"
    fi
    log ""
    log "#########################################"
}

finish_success() {
    local hostname="$1"
    local dbname="$2"
    local dbuser="$3"
    local dbpass="$4"

    log ""
    log "Loading ======================> 100 %"
    log ""
    log "**************************************************"
    log ""
    log "If you filled in the needed values, OSPOS should now be available at:"
    log ""
    log "https://${hostname}/OSPOS/public"
    log ""
    log "Login credentials:"
    log "Username: admin"
    log "Password: pointofsale"

    if [ -n "$dbname" ] && [ -n "$dbuser" ] && [ -n "$dbpass" ]; then
        log ""
        log "Database credentials:"
        log "Database: $(current_user)_${dbname}"
        log "Username: $(current_user)_${dbuser}"
        log "Password: ${dbpass}"
    fi

    log ""
    log "**************************************************"
    log ""
    log "Enjoy OSPOS"
}

run_install() {
    local mode="$1"
    local dbname
    local dbuser
    local dbpass
    local hostname
    local answer

    backup_webroot
    download_release
    extract_release

    log ""
    log "OSPOS has been installed in ${INSTALL_ROOT}"
    log ""
    read -r -p ">> Shall we help you create the DB files (Y/N)? " answer
    if [[ "$answer" == "Y" || "$answer" == "y" ]]; then
        log ""
        read -r -p ">> MySQL database name? " dbname
        read -r -p ">> MySQL database username? " dbuser
        read -r -p ">> MySQL user password? " dbpass
        read -r -p ">> What's your hostname? " hostname
        hostname="${hostname:-localhost}"

        dbname="$(sanitize_token "$dbname")"
        dbuser="$(sanitize_token "$dbuser")"

        if [ -z "$dbname" ] || [ -z "$dbuser" ]; then
            log "Database name and username must contain at least one alphanumeric character."
            exit 1
        fi

        write_database_config "$dbname" "$dbuser" "$dbpass"

        log ""
        log "Database config file created successfully:"
        log "${INSTALL_ROOT}/application/config/database.php"
        log ""
        read -r -p ">> Do you want to create and import the default DB (Y/N)? " answer
        if [[ "$answer" == "Y" || "$answer" == "y" ]]; then
            if [ "$mode" = "mysql" ]; then
                create_mysql_db "$dbname" "$dbuser" "$dbpass" || exit 1
            else
                create_cpanel_db "$dbname" "$dbuser" "$dbpass" || exit 1
            fi
        fi
    else
        hostname="localhost"
        dbname=""
        dbuser=""
        dbpass=""
    fi

    log ""
    log "Removing installation files"
    publish_install
    cleanup
    finish_success "$hostname" "$dbname" "$dbuser" "$dbpass"
}

local_deployment_menu() {
    while true; do
        log ""
        log "Local Deployment"
        log "#########################################"
        log "1) FreeBSD Ubuntu CentOS"
        log "2) Raspberry PI"
        log "3) cPanel / Webmin / Online"
        log "4) Back to Main Menu"
        read -r -p "Choice [1-4]: " choice

        case "$choice" in
            1)
                log ""
                log "Preparing Ubuntu/CentOS installation"
                run_install mysql
                return
                ;;
            2)
                log "This isn't ready yet! Please check it back later..."
                ;;
            3)
                log ""
                log "Preparing FreeBSD/cPanel/Webmin installation"
                run_install cpanel
                return
                ;;
            4)
                return
                ;;
            *)
                log "Invalid entry."
                ;;
        esac
    done
}

main_menu() {
    while true; do
        log ""
        log "What would you like us to help you with?"
        log "#########################################"
        log "1) Web Server Configuration & Setup"
        log "2) Local Deployment"
        log "3) Display System Info"
        log "4) Exit"
        read -r -p "Choice [1-4]: " choice

        case "$choice" in
            1)
                log "This isn't ready yet! Please check it back later..."
                ;;
            2)
                local_deployment_menu
                ;;
            3)
                display_system_info
                ;;
            4)
                log "Exiting now..."
                exit 0
                ;;
            *)
                log "Invalid entry."
                ;;
        esac
    done
}

main() {
    trap cleanup EXIT
    banner

    if [ "${1:-}" != "" ]; then
        log "This installer is interactive and does not take arguments."
        exit 1
    fi

    main_menu
}

main "$@"
